schema_version: 1

context:
  version: "@VERSION@"

package:
  name: enumeray
  version: ${{ version }}

source:
  url: "@SOURCE_URL@"
  sha256: "@SOURCE_SHA256@"

build:
  number: 0
  skip: target_platform not in ["linux-64", "linux-aarch64", "osx-64", "osx-arm64"]
  script: build.sh

requirements:
  build:
    - ${{ compiler('rust') }}
    - ${{ compiler('c') }}
    - ${{ compiler('cxx') }}
    - ${{ stdlib('c') }}
    - rust ==@RUST_VERSION@
    - cargo-auditable
    - cargo-bundle-licenses
    - jq
    - cmake
    - ninja
    - make
    - perl
  run:
    - if: linux
      then: __glibc >=2.28
    - if: osx
      then: __osx >=14.0

tests:
  - script: |
      set -eu
      test "$(enumeray --version)" = "enumeray ${{ version }}"
      enumeray connector --help
      enumeray compute-runner --help
      test -f "$PREFIX/share/enumeray/compatibility.json"
      test -f "$PREFIX/share/enumeray/source.json"
      temporary=$(mktemp -d)
      trap 'rm -rf "$temporary"' 0 HUP INT TERM
      journal="$temporary/qualification-journal"
      enumeray connector init --journal "$journal" --api-base-url http://127.0.0.1:8080 \
        --connector-id conda-qualification > "$temporary/initialized.json"
      enumeray connector inspect --journal "$journal" > "$temporary/inspected.json"
      test "$(jq -er .journal_id "$temporary/initialized.json")" = "$(jq -er .journal_id "$temporary/inspected.json")"
    requirements:
      run:
        - jq

about:
  homepage: https://enumeray.com
  summary: Run scientific models through an authorized Enumeray service
  description: CLI, outbound connector and compute runner in one native executable.
  license: Apache-2.0
  license_file:
    - LICENSE
    - THIRD_PARTY_NOTICES.json
    - THIRDPARTY.yml
  repository: https://github.com/raysofspace/enumeray-cli
  documentation: https://doc.enumeray.com/

extra:
  recipe-maintainers:
@MAINTAINERS@
