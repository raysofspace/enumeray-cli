{
  "manifest_version": 1,
  "api_base_url": "https://enumeray.example.org",
  "context": {
    "id": "lab-cpu",
    "connector_id": "lab-connector",
    "definition": {
      "driver": {
        "kind": "process",
        "scratch": {
          "max_bytes": 1073741824,
          "max_entries": 10000,
          "max_depth": 32,
          "scan_interval_ms": 1000,
          "cache": "per_run",
          "symlinks": "forbid"
        }
      },
      "installation_roots": [
        "/opt/enumeray/models"
      ],
      "work_root": "/var/lib/enumeray-model-work",
      "max_outstanding_assignments": 4,
      "connection": {
        "kind": "direct",
        "launcher": [
          "/usr/bin/sudo",
          "-n",
          "-u",
          "model-runner",
          "--",
          "/opt/enumeray/bin/enumeray"
        ]
      }
    },
    "metadata": {
      "location": "Research lab",
      "disclosure": "Research-owned machines."
    }
  },
  "connector_account": {
    "platform": "linux",
    "name": "enumeray-connect",
    "group": "enumeray-connect",
    "home": "/var/lib/enumeray-connect",
    "create": true,
    "uid": null,
    "gid": null
  },
  "execution_account": {
    "platform": "linux",
    "name": "model-runner",
    "group": "model-runner",
    "home": "/var/lib/enumeray-model",
    "create": true,
    "uid": null,
    "gid": null
  },
  "connector_executable": "/opt/enumeray/bin/enumeray",
  "journal": "/var/lib/enumeray-connect/journal",
  "token_file": "/var/lib/enumeray-connect/credentials/token",
  "credentials_file": null,
  "max_workers": 4,
  "max_transfer_workers": 2,
  "max_pending_assignments": 64,
  "shutdown_timeout_seconds": 30
}
